  "strings": {
    "en": {
      "greeting": "Nine-one-one, what is the emergency?",
      "q_what": "Tell me exactly what happened.",
      "q_when": "When did this happen — is it happening right now, did it just occur, or is it cold?",
      "q_where": "Where did it happen? What is the address?",
      "confirm_where": "Confirming: {location} — is that correct? Is that a house or an apartment?",
      "q_dwelling": "Is that a house or an apartment, and which unit?",
      "q_caller_name": "What is your name?",
      "q_callback": "What number are you calling from, in case we get disconnected?",
      "confirm_callback": "That's {callback} — correct?",
      "q_suspect_there": "Is the suspect there now?",
      "q_weapons": "Are there any weapons involved? Never mind if you're not sure — do you see or did they mention a gun, a knife, anything?",
      "clarify": "I need a clear answer — take a breath, you're doing fine.",
      "dispatch_confirm": "Officers are being sent to {location}. Stay on the line with me.",
      "closing": "Help is on the way. Call back immediately if anything changes.",
      "kq_suspect_desc": "Describe the suspect for me, one at a time, from the top down — race, sex, age, hair, then clothing.",
      "kq_burg_vehicle": "What kind of vehicle is parked in the driveway or out front? Can you see a license plate?",
      "kq_caller_safe": "Where are you right now? Can you stay safely on the line with me?",
      "kq_weapon_kind": "What kind of weapon was it — a gun, a knife, something else? Who has it?",
      "kq_vehicle": "Is there a vehicle involved? Describe it — color, make, and the plate if you can see it.",
      "kq_direction": "Which direction did they go — on foot or in the vehicle?",
      "kq_dv_physical": "Is this physical or verbal?",
      "kq_dv_speak_freely": "Can you speak freely right now?",
      "kq_susp_doing": "What exactly are they doing?",
      "kq_acc_injuries": "Are there any injuries? I have to ask every time.",
      "kq_acc_vehicles": "How many vehicles are involved, and can you describe them?",
      "kq_acc_blocking": "Are the vehicles blocking traffic?",
      "kq_unk_details": "Tell me more about what you're seeing or hearing.",
      "pd_units_coming": "Officers are on the way. I'll stay on the line with you as long as it's safe for you to talk.",
      "pd_stay_safe": "Do not confront the suspect. Keep yourself somewhere safe.",
      "pd_no_confront": "Do not approach or confront the person. Keep watching from a safe place if you can.",
      "pd_updates": "If anything changes — if they leave, come back, or you see a vehicle — tell me right away.",
      "pd_dv_code": "If you can't talk safely, just answer yes or no to my questions.",
      "pd_ems_transfer": "You also need medical or fire — I'm connecting you with fire and medical dispatch now. Stay on the line."
    }
  }
