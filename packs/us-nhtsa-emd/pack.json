{
  "schemaVersion": "0.1",
  "id": "us-nhtsa-emd",
  "name": {
    "en": "US — NHTSA EMD Curriculum (reference subset)",
    "es": "EE. UU. — Currículo EMD de la NHTSA (subconjunto de referencia)"
  },
  "jurisdiction": {
    "country": "US",
    "region": "Generic (federal curriculum, no specific PSAP)",
    "emergencyNumber": "911"
  },
  "provenance": {
    "source": "U.S. DOT / NHTSA, Emergency Medical Dispatch: National Standard Curriculum (public domain); heavily simplified reference subset for engine development",
    "url": "https://files.eric.ed.gov/fulltext/ED425308.pdf",
    "license": "public-domain",
    "digitizedDate": "2026-08-19",
    "notes": "NOT a complete or faithful protocol. Demonstrates the pack format: case entry, protocol selection, key-question branching, determinants, post-dispatch instructions, and bilingual catalogs. Never use for real call-taking or medical guidance. Full curriculum text (805 pp., DOT-HS-808-354/356, public domain) verified 2026-08-20 at the ERIC url above; note the curriculum ships the EMDPRS card STRUCTURE and 32 complaint lessons but deliberately no filled-in cards (local medical-director approval required), so this pack remains a simplified reference subset."
  },
  "locales": [
    "en",
    "es"
  ],
  "defaultLocale": "en",
  "caseEntry": [
    {
      "id": "q_address",
      "slot": "address",
      "stringId": "q_address",
      "confirmStringId": "confirm_address"
    },
    {
      "id": "q_callback",
      "slot": "callback",
      "stringId": "q_callback",
      "confirmStringId": "confirm_callback"
    },
    {
      "id": "q_complaint",
      "slot": "complaint",
      "stringId": "q_complaint",
      "selectsProtocol": true
    },
    {
      "id": "q_age",
      "slot": "age",
      "stringId": "q_age"
    },
    {
      "id": "q_conscious",
      "slot": "conscious",
      "stringId": "q_conscious",
      "expect": {
        "type": "choice",
        "options": [
          {
            "id": "no",
            "keywords": {
              "en": [
                "no",
                "unconscious",
                "passed out",
                "nope",
                "negative",
                "none"
              ],
              "es": [
                "no",
                "inconsciente",
                "desmayado",
                "nada",
                "negativo",
                "ninguno",
                "ninguna",
                "tampoco",
                "en absoluto"
              ]
            }
          },
          {
            "id": "yes",
            "keywords": {
              "en": [
                "yes",
                "yeah",
                "awake",
                "yep",
                "correct",
                "affirmative"
              ],
              "es": [
                "sí",
                "si",
                "despierto",
                "correcto",
                "afirmativo",
                "así es",
                "asi es",
                "claro"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "q_breathing",
      "slot": "breathing",
      "stringId": "q_breathing",
      "expect": {
        "type": "choice",
        "options": [
          {
            "id": "no",
            "keywords": {
              "en": [
                "no",
                "not breathing",
                "nope",
                "negative",
                "none"
              ],
              "es": [
                "no",
                "nada",
                "negativo",
                "ninguno",
                "ninguna",
                "tampoco",
                "en absoluto"
              ]
            }
          },
          {
            "id": "yes",
            "keywords": {
              "en": [
                "yes",
                "yeah",
                "breathing",
                "yep",
                "correct",
                "affirmative"
              ],
              "es": [
                "sí",
                "si",
                "respira",
                "correcto",
                "afirmativo",
                "así es",
                "asi es",
                "claro"
              ]
            }
          }
        ]
      },
      "next": [
        {
          "whenOption": "no",
          "goto": "$determine"
        }
      ]
    }
  ],
  "protocols": [
    {
      "id": "chest_pain",
      "name": {
        "en": "Chest Pain",
        "es": "Dolor de pecho"
      },
      "keywords": {
        "en": [
          "chest pain",
          "chest hurts",
          "heart attack",
          "chest pressure"
        ],
        "es": [
          "dolor de pecho",
          "pecho",
          "infarto"
        ]
      },
      "keyQuestions": [
        {
          "id": "kq_cp_alert",
          "slot": "cp_alert",
          "stringId": "kq_cp_alert",
          "expect": {
            "type": "choice",
            "options": [
              {
                "id": "no",
                "keywords": {
                  "en": [
                    "no",
                    "confused",
                    "out of it",
                    "nope",
                    "negative",
                    "none"
                  ],
                  "es": [
                    "no",
                    "confundido",
                    "nada",
                    "negativo",
                    "ninguno",
                    "ninguna",
                    "tampoco",
                    "en absoluto"
                  ]
                }
              },
              {
                "id": "yes",
                "keywords": {
                  "en": [
                    "yes",
                    "yeah",
                    "alert",
                    "yep",
                    "correct",
                    "affirmative"
                  ],
                  "es": [
                    "sí",
                    "si",
                    "alerta",
                    "correcto",
                    "afirmativo",
                    "así es",
                    "asi es",
                    "claro"
                  ]
                }
              }
            ]
          },
          "next": [
            {
              "whenOption": "no",
              "goto": "$determine"
            },
            {
              "goto": "kq_cp_clammy"
            }
          ]
        },
        {
          "id": "kq_cp_clammy",
          "slot": "cp_clammy",
          "stringId": "kq_cp_clammy",
          "expect": {
            "type": "choice",
            "options": [
              {
                "id": "no",
                "keywords": {
                  "en": [
                    "no",
                    "dry",
                    "nope",
                    "negative",
                    "none"
                  ],
                  "es": [
                    "no",
                    "seca",
                    "nada",
                    "negativo",
                    "ninguno",
                    "ninguna",
                    "tampoco",
                    "en absoluto"
                  ]
                }
              },
              {
                "id": "yes",
                "keywords": {
                  "en": [
                    "yes",
                    "yeah",
                    "sweaty",
                    "pale",
                    "clammy",
                    "yep",
                    "correct",
                    "affirmative"
                  ],
                  "es": [
                    "sí",
                    "si",
                    "sudoroso",
                    "pálido",
                    "palido",
                    "correcto",
                    "afirmativo",
                    "así es",
                    "asi es",
                    "claro"
                  ]
                }
              }
            ]
          }
        }
      ],
      "determinants": [
        {
          "id": "cp_not_alert",
          "when": [
            {
              "slot": "cp_alert",
              "option": "no"
            }
          ],
          "response": "ALS_HOT"
        },
        {
          "id": "cp_clammy",
          "when": [
            {
              "slot": "cp_clammy",
              "option": "yes"
            }
          ],
          "response": "ALS_HOT"
        },
        {
          "id": "cp_default",
          "response": "ALS_COLD"
        }
      ],
      "postDispatch": [
        "pd_rest",
        "pd_nothing_by_mouth",
        "pd_callback_worse"
      ]
    },
    {
      "id": "unconscious_fainting",
      "name": {
        "en": "Unconscious / Fainting",
        "es": "Inconsciente / Desmayo"
      },
      "keywords": {
        "en": [
          "unconscious",
          "passed out",
          "fainted",
          "not waking"
        ],
        "es": [
          "inconsciente",
          "desmayado",
          "desmayo",
          "no despierta"
        ]
      },
      "keyQuestions": [
        {
          "id": "kq_unc_breathing",
          "slot": "unc_breathing",
          "stringId": "kq_unc_breathing",
          "expect": {
            "type": "choice",
            "options": [
              {
                "id": "no",
                "keywords": {
                  "en": [
                    "no",
                    "not breathing",
                    "gasping",
                    "nope",
                    "negative",
                    "none"
                  ],
                  "es": [
                    "no",
                    "jadeando",
                    "nada",
                    "negativo",
                    "ninguno",
                    "ninguna",
                    "tampoco",
                    "en absoluto"
                  ]
                }
              },
              {
                "id": "yes",
                "keywords": {
                  "en": [
                    "yes",
                    "yeah",
                    "breathing",
                    "yep",
                    "correct",
                    "affirmative"
                  ],
                  "es": [
                    "sí",
                    "si",
                    "respira",
                    "correcto",
                    "afirmativo",
                    "así es",
                    "asi es",
                    "claro"
                  ]
                }
              }
            ]
          },
          "next": [
            {
              "whenOption": "no",
              "goto": "$determine"
            }
          ]
        }
      ],
      "determinants": [
        {
          "id": "unc_not_breathing",
          "when": [
            {
              "slot": "unc_breathing",
              "option": "no"
            }
          ],
          "response": "ALS_HOT"
        },
        {
          "id": "unc_default",
          "response": "ALS_HOT"
        }
      ],
      "postDispatch": [
        "pd_dont_move",
        "pd_watch_breathing",
        "pd_callback_worse"
      ]
    },
    {
      "id": "general_medical",
      "name": {
        "en": "General Medical (fallback)",
        "es": "Médico general (por defecto)"
      },
      "keywords": {
        "en": [
          "sick"
        ],
        "es": [
          "enfermo"
        ]
      },
      "keyQuestions": [],
      "determinants": [
        {
          "id": "gm_default",
          "response": "BLS_COLD"
        }
      ],
      "postDispatch": [
        "pd_callback_worse"
      ]
    }
  ],
  "fallbackProtocol": "general_medical",
  "strings": {
    "en": {
      "greeting": "Nine-one-one.",
      "q_address": "What is the address of the emergency?",
      "q_callback": "What is the phone number you are calling from?",
      "confirm_address": "Okay, {address}.",
      "confirm_callback": "And if we get disconnected, I can reach you at {callback}?",
      "q_complaint": [
        "Okay, tell me exactly what happened.",
        "What is your emergency?"
      ],
      "q_age": "How old is the patient?",
      "q_conscious": "Is the patient conscious?",
      "q_breathing": "Is the patient breathing?",
      "kq_cp_alert": "Is the patient completely alert and able to speak to you normally?",
      "kq_cp_clammy": "Is the patient pale, sweaty, or clammy?",
      "kq_unc_breathing": "Watch the chest closely — is the patient breathing normally right now?",
      "dispatch_confirm": "Help is on the way to {address}. Stay on the line.",
      "clarify": "I need you to answer yes or no for me.",
      "pd_rest": "Help the patient into a comfortable position and do not let them walk around.",
      "pd_nothing_by_mouth": "Do not give the patient anything to eat or drink.",
      "pd_dont_move": "Do not move the patient unless they are in danger.",
      "pd_watch_breathing": "Stay with the patient and watch their breathing closely.",
      "pd_callback_worse": "If anything changes or gets worse, call back immediately.",
      "closing": "Responders are on the way. I am going to let you go now."
    },
    "es": {
      "greeting": "Nueve-uno-uno.",
      "q_address": "¿Cuál es la dirección de la emergencia?",
      "q_callback": "¿Cuál es el número de teléfono desde el que llama?",
      "confirm_address": "Bien, {address}.",
      "confirm_callback": "Y si se corta la llamada, ¿puedo llamarle al {callback}?",
      "q_complaint": [
        "Bien, dígame exactamente qué pasó.",
        "¿Cuál es su emergencia?"
      ],
      "q_age": "¿Qué edad tiene el paciente?",
      "q_conscious": "¿Está consciente el paciente?",
      "q_breathing": "¿Está respirando el paciente?",
      "kq_cp_alert": "¿Está el paciente completamente alerta y puede hablarle con normalidad?",
      "kq_cp_clammy": "¿Está el paciente pálido, sudoroso o con la piel fría?",
      "kq_unc_breathing": "Observe el pecho con atención: ¿está respirando normalmente en este momento?",
      "dispatch_confirm": "La ayuda va en camino a {address}. Permanezca en la línea.",
