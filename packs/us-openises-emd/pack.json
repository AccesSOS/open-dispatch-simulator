        },
        {
          "id": "kq_m17_breathing_normal", "slot": "m17_breathing_normal", "stringId": "kq_breathing_normal",
          "expect": { "type": "choice", "options": [
            { "id": "no", "keywords": { "en": ["no", "not"] } },
            { "id": "yes", "keywords": { "en": ["yes", "yeah", "normal", "normally"] } }
          ] },
          "next": [ { "whenOption": "no", "goto": "$determine" }, { "goto": "kq_m17_why_down" } ]
        },
        { "id": "kq_m17_why_down", "slot": "m17_why_down", "stringId": "kq_m17_why_down" },
        {
          "id": "kq_m17_able_talk", "slot": "m17_able_talk", "stringId": "kq_m17_able_talk",
          "expect": { "type": "choice", "options": [
            { "id": "no", "keywords": { "en": ["no", "not"] } },
            { "id": "yes", "keywords": { "en": ["yes", "yeah", "talking"] } }
          ] }
        },
        {
          "id": "kq_m17_able_move", "slot": "m17_able_move", "stringId": "kq_m17_able_move",
          "expect": { "type": "choice", "options": [
            { "id": "no", "keywords": { "en": ["no", "not"] } },
            { "id": "yes", "keywords": { "en": ["yes", "yeah", "moving"] } }
          ] }
        },
        { "id": "kq_m17_where_exactly", "slot": "m17_where_exactly", "stringId": "kq_m17_where_exactly" }
      ],
      "determinants": [
        { "id": "m17_red_not_breathing", "when": [{ "slot": "breathing", "option": "no" }], "response": "CODE_RED" },
        { "id": "m17_red_unconscious", "when": [{ "slot": "m17_alert", "option": "no" }], "response": "CODE_RED" },
        { "id": "m17_red_breathing_abnormal", "when": [{ "slot": "m17_breathing_normal", "option": "no" }], "response": "CODE_RED" },
        { "id": "m17_yellow_talking_moving", "response": "CODE_YELLOW" }
      ],
      "postDispatch": ["pd_m17_go_check", "pd_m17_flag_unit", "pd_callback_changes"]
    }
  ],
  "fallbackProtocol": "m17_unknown_man_down",
  "strings": {
    "en": {
      "greeting": "Nine-one-one.",
      "q_location": "Where is your emergency — what is the address or location?",
      "confirm_location": "I have {location} — is that correct?",
      "q_callback": "What is the phone number you are calling from?",
      "confirm_callback": "I have {callback} — is that correct?",
      "q_emergency": "What is the emergency?",
      "q_num_hurt": "How many people are hurt?",
      "q_age": "How old is the person?",
      "q_conscious": "Is the person conscious?",
      "q_breathing": "Is the person breathing?",
      "q_sex": "Is the person male or female?",
      "q_caller_name": "What is your name?",
      "clarify": "I need a yes or no answer.",
      "dispatch_confirm": "Help has been dispatched to {location}. Stay on the line with me.",
      "closing": "Emergency responders are on the way. Call back immediately if anything changes.",
      "kq_alert": "Is the person alert?",
      "kq_breathing_normal": "Is the person breathing normally?",
      "kq_m5_sweating": "Is the person sweating profusely?",
      "kq_m5_nausea": "Is the person nauseated or vomiting?",
      "kq_m5_weak": "Is the person weak, dizzy or faint?",
      "kq_m5_pain_location": "Where is the pain located?",
      "kq_m5_rapid_heart": "Does the person experience a rapid heart rate with the chest pain?",
      "kq_m5_pain_elsewhere": "Does the person feel pain anywhere else?",
      "kq_m5_duration": "How long has the pain been present?",
      "kq_m5_cardiac_history": "Does the person have a history of a heart attack or cardiac problems?",
      "kq_m5_drugs": "Has the person taken any drugs in the past 24 hours?",
      "pd_m5_position": "Place the person in the most comfortable position, probably sitting up.",
      "pd_m5_no_exertion": "Advise the person not to exert themselves.",
      "pd_m5_loosen": "Loosen any tight clothing.",
      "pd_m5_nitro": "If the person is prescribed nitroglycerin and has it, make sure they are sitting down, then have them take it as prescribed by their doctor.",
      "kq_c1_breathing_normal": "Is the person breathing normally? Gasping, snoring, gurgling, or barely breathing is not normal breathing.",
      "kq_c1_responds": "Does the person respond to you? Does the person move?",
      "kq_c1_expected": "Is this an expected death — is the person in hospice care?",
      "pd_c1_cpr": "I am going to give you CPR instructions appropriate for the person's age. Follow them until responders arrive.",
      "pd_c1_callback": "If the person's condition changes, or you decide to provide CPR, call me back immediately.",
      "kq_c6_first_time": "Is this the first time today that the person has been unconscious?",
      "kq_c6_tried_wake": "Have you tried to wake the person up?",
      "kq_c6_drugs_alcohol": "Do you know if the person is taking any drugs, or drinking alcohol — alone or with the drugs?",
      "kq_c6_doing_before": "What was the person doing before they became unconscious?",
      "kq_c6_complaints_before": "Did the person have any complaints before they went unconscious?",
      "kq_c6_medic_alert": "Does the person have a Medic Alert tag? If so, what does it say?",
      "pd_c6_lie_down": "Have the person lie down.",
      "pd_c6_side_vomit": "If the person is vomiting, place them on their side.",
      "pd_c6_stay": "Do not leave the person, and be prepared to perform CPR.",
      "kq_m17_why_down": "Do you know why the person is down?",
      "kq_m17_able_talk": "Is the person able to talk?",
      "kq_m17_able_move": "Is the person able to move?",
      "kq_m17_where_exactly": "Where exactly is the person?",
      "pd_m17_go_check": "If it is safe to do so, go to the person and see if they are awake, breathing normally, or moving at all — then return to the phone and let me know.",
      "pd_m17_flag_unit": "Watch for the emergency unit and direct them to the person.",
      "pd_gather_meds": "Gather any of the person's medications for the paramedics.",
      "pd_lock_pets": "Lock away any pets.",
      "pd_callback_changes": "If the person's condition changes, call me back immediately."
    }
  }
}
