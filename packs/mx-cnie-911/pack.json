    "es": {
      "greeting": "Nueve-uno-uno, ¿cuál es su emergencia?",
      "q_ubicacion": "¿Cuál es la dirección o ubicación de la emergencia?",
      "confirm_ubicacion": "Le confirmo: {ubicacion}, ¿es correcto?",
      "q_telefono": "¿De qué número de teléfono llama?",
      "confirm_telefono": "Le confirmo: {telefono}, ¿es correcto?",
      "q_que_sucede": "Dígame, ¿qué es lo que sucede?",
      "q_nombre": "¿Cuál es su nombre?",
      "q_edad": "¿Qué edad tiene la persona?",
      "q_consciente": "¿Está consciente la persona?",
      "q_respira": "¿Está respirando la persona?",
      "clarify": "Necesito que me responda sí o no, por favor.",
      "dispatch_confirm": "Ya se envió la ayuda a {ubicacion}. Permanezca en la línea.",
      "closing": "Los servicios de emergencia van en camino. Si algo cambia, marque de nuevo al nueve-uno-uno.",
      "kq_inf_dolor": "¿Siente la persona un dolor intenso o una opresión en el pecho?",
      "kq_inf_brazo": "¿Le duele el brazo izquierdo o el cuello?",
      "kq_inf_sudor": "¿Está sudando abundantemente?",
      "kq_inf_nausea": "¿Tiene náuseas o está vomitando?",
      "kq_paro_responde": "¿La persona responde cuando le habla? ¿Se mueve?",
      "kq_paro_desde": "¿Desde hace cuánto tiempo está así?",
      "kq_inc_respira_normal": "¿Está respirando normalmente? Jadear o respirar apenas no es normal.",
      "kq_inc_primera_vez": "¿Es la primera vez hoy que pierde el conocimiento?",
      "kq_dif_habla": "¿Puede la persona hablar en frases completas?",
      "kq_conv_sigue": "¿Sigue convulsionando en este momento?",
      "kq_conv_primera": "¿Es la primera vez que convulsiona?",
      "pd_no_mover": "No mueva a la persona a menos que esté en peligro.",
      "pd_de_lado": "Si la persona vomita, colóquela de lado.",
      "pd_no_sujetar": "No sujete a la persona ni le meta nada en la boca.",
      "pd_no_colgar": "Si la situación cambia o empeora, llame de inmediato al nueve-uno-uno."
    }
